import datetime
current_date = datetime.datetime.now()
current_date = f"{current_date.strftime('%m_%d_%H%M')}"


# [DATA INPUT]
# We can specify a config-file to use for simplifying running the workflow for specific samples
configfile: "/home/alvin/HiC_project/scripts/bbduk/trimming_snakefile_config.yaml"

# We can also specify a target-file containing which samples we want to run in a job (helps to save alot of terminal space and time if we want to process multiple samples in the same job)
TARGET_FILE=config["target_file"]

# Function to allow snakefile to handle .txt-files specifying target-files
def read_targets(filename):
    with open(filename) as targets:
        return [
            line.strip()
            for line in targets
            if line.strip() and not line.lstrip().startswith("#")
            ]


TARGET_SAMPLES = read_targets(TARGET_FILE) # Creating a list containing the samples listed in 'sample_input_test_for_snakemake.txt'

# All samples in dataset
sample_paths = config["sample_paths"]

# and their corresponding group in the context of the study
sample_group = config["sample_group"]

# Too see whether there are any unknown samples, i.e. samples listed in 'sample_input_test_for_snakemake.txt' but not present in 'snakefile_config.yaml'
UNKNOWN_SAMPLES = set(TARGET_SAMPLES) - set(sample_paths)
if UNKNOWN_SAMPLES:
    raise ValueError(
        "The following samples occur in 'sample_input_for_trimming_snakemake.txt' but not under 'samples:' in 'trimming_snakefile_config.yaml':"
        f"{sorted(UNKNOWN_SAMPLES)}"
    )

# [SNAKEFILE RULES]
# This rule will create (globally declare) all the outputs that the job will attempt to create using the target samples we have provided via 'sample_input_test_for_snakemake.txt'
rule all:
    input:
        [f"/storage/alvin/HiC_stuff/bbduk_output/{sample_group[sample]}/{sample}/{sample}_R1_trimmed.fastq.gz" for sample in TARGET_SAMPLES],
        [f"/storage/alvin/HiC_stuff/bbduk_output/{sample_group[sample]}/{sample}/{sample}_R2_trimmed.fastq.gz" for sample in TARGET_SAMPLES],
    default_target: True


# Rules are specified using the "rule" command. Rules are core functional units in snakefiles.
rule bbduk:
    # All rules need the options "input", "output" and "shell" for minimal functionality of a snakefile
    input: # Here we specify what input-files the rule should take
        # The use of the lambda function-constructor allows us to generalize our workflow and process output for different samples by only doing the sample-lookup once the job is ran. 'lambda arguments : expression'
        R1=lambda wildcards: (f"{sample_paths[wildcards.sample]}_R1_001.fastq.gz"),
        R2=lambda wildcards: (f"{sample_paths[wildcards.sample]}_R2_001.fastq.gz")

    output: # Here we specify what output-files are generated by the rule
        R1="/storage/alvin/HiC_stuff/bbduk_output/{group}/{sample}/{sample}_R1_trimmed.fastq.gz",
        R2="/storage/alvin/HiC_stuff/bbduk_output/{group}/{sample}/{sample}_R2_trimmed.fastq.gz"

    # With the 'log'-option we can specify where we want our logs for the jobs to be directed to
    log:
        bbduk_log='/home/alvin/HiC_project/logs/bbduk/{group}/{sample}/{sample}'f"_{current_date}.log",
        fastqc_log='/home/alvin/HiC_project/logs/fastqc/{group}/{sample}/{sample}'f"_{current_date}.log"

    # Here we specify the max number of logical threads the rule is allowed to allocate to a job
    threads: 20

    params:
        # Here we specify what parameters we want to pass to the input
    
    shell:
        # Here we specify the command that we want snakemake to run
        # The use of triple-quotes allows us to specify multiline commands
        """
        set -euo pipefail

        mkdir -p "$(dirname {output.R1})" "$(dirname {log.bbduk_log})" "$(dirname {log.fastqc_log})" "/home/alvin/HiC_project/tool_output/fastqc/bbduk_trimmed/{wildcards.group}/"

        # Trim away inaccurate number of bases from reads; the 151 bp reads that are sometimes generated from Illumina are reduced to 150 bp
        # 'out=stdout.fq' and 'out=stdin.fq' are required for being able to pipe i/o between bbduk-commands.
        echo "Now running bbduk on sample '{wildcards.sample}'"
        bbduk.sh in1={input.R1} in2={input.R2} out=stdout.fq ftm=5 threads={threads} 2>> {log.bbduk_log} | \

        # From the right, trim away all adapters present in the bbduk-bundled 'adapter' reference-database, as-well as the specified group-specific overrepresented sequences. 
        # mink='minimum k-mer'. krim='k(-mer) trim'. hdist='hamming-distance'. tpe='trimpairsevenly'. tbo='trimbyoverlap'. 'int=t', basically 'interleaved=true', specifies that the input is interleaved, so that the bbduk-call correctly identifies which reads are which.
        bbduk.sh in=stdin.fq int=t out=stdout.fq ref=adapters ktrim=r k=23 mink=11 hdist=1 tpe=t tbo=t threads={threads} 2>> {log.bbduk_log} | \
  
        # Starting from the left end of each read, trim away bases with quality below 'trimq'-value, i.e. below Phred-value 25. Uses Phred algorithm for more accurate trimming than naive approaches. 
        bbduk.sh in=stdin.fq int=t out={output.R1} out2={output.R2} qtrim=l trimq=25 threads={threads} 2>> {log.bbduk_log}

        # IN CASE CONTAMINATION TURNS OUT TO BE PROBLEM: Remove contaminating sequences?
        #bbduk.sh in=stdin.fq int=t out={output.R1} out2={output.R2} ref=???? k=31 hdist=1 2>> {log.bbduk_log}

        # Sending email to confirm that bbduk has finished
        # "echo 'mail-contents' | mail -s 'mail-subject' username@adress.domain
        echo -E "As of {current_date}, all reads in '{wildcards.sample}' have now been:\n  -Shortened to max 150 basepairs\n  -Had any detected adapter-sequences trimmed away\n  -Had low quality-bases trimmed away" | \
        mail -s "'{wildcards.sample}' - BBduk trimming/adapter removal" gusalvisu@student.gu.se
        
        
        # Running fastqc on the trimmed and filtered bbduk-output
        echo "Now running fastqc on '{wildcards.sample}'."
        fastqc --threads 2 -o "/home/alvin/HiC_project/tool_output/fastqc/bbduk_trimmed/{wildcards.group}" {output.R1} {output.R2} 2> {log.fastqc_log}

        # Sending email to confirm that job has finished
        echo -E "As of {current_date}, all reads in '{wildcards.sample}' have now been checked by fastQC" | mail -s "'{wildcards.sample}' - fastQC check" gusalvisu@student.gu.se
